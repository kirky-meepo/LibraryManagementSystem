# Copy this file to .env and fill in real values. Never commit .env.
# dev shows error details; prod shows a friendly page and logs details to storage/logs.
APP_ENV=dev

# Database the PHP app uses (the lms_app role is created by database/05_roles.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms
DB_USER=lms_app
DB_PASS=same-value-as-APP_DB_PASS

# Password the reset script gives the lms_app role. Use letters and digits only.
APP_DB_PASS=change-me-to-a-long-random-value

# The only account: the office admin, made by every database reset (06_seed.sql and seed_passwords.php).
OFFICE_ADMIN_EMAIL=
# At least 8 characters (14 when APP_ENV=prod). Never commit it.
OFFICE_ADMIN_PASSWORD=

# PostgreSQL superuser, used only by database/reset.ps1, reset.sh and the tests
PGUSER=postgres
PGPASSWORD=your-postgres-password

# Optional: full path to php.exe or psql.exe if they are not on PATH
# PHP_BIN=C:\php\php.exe
# PSQL_BIN=C:\Program Files\PostgreSQL\18\bin\psql.exe

# Email (src/mail.php). outbox writes each message to storage/outbox/ (development and tests).
# brevo sends through Brevo's API; see README, "Real password-reset email". Never commit a real key.
MAIL_DRIVER=outbox
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Library
# Base address used in emailed links (never taken from the request)
APP_URL=http://localhost:8000

# Hosting (defaults suit this PC; a hosted site sets these as real environment variables, which win over .env)
# prefer on this PC; require for a hosted PostgreSQL
DB_SSLMODE=prefer
# 1 only for a pooled connection string (PgBouncer in transaction mode)
DB_EMULATE_PREPARES=0
# files on this PC; db keeps sessions in PostgreSQL (a hosted site has no lasting disk)
SESSION_DRIVER=files
# 1 only behind a proxy that sets X-Real-IP / X-Forwarded-For (Vercel); then the lock-out counts the real visitor
TRUST_PROXY=0
# 1 writes error logs to stderr instead of storage/logs (a hosted disk is read-only)
LOG_TO_STDERR=0
# Only for database\reset.ps1 -Hosted (docs/DEPLOY.md). Better set it in the PowerShell window than here.
# DATABASE_ADMIN_URL=postgresql://user:password@host:5432/dbname?sslmode=require
